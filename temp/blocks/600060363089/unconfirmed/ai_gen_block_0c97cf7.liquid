{% doc %}
  @prompt
    O cronologie verticală interactivă care se evidențiază pe măsură ce utilizatorul derulează
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}.ai-timeline-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;color:{{ block.settings.text_color }};background:{{ block.settings.background_color }};padding:{{ block.settings.vertical_padding }}px {{ block.settings.horizontal_padding }}px;border-radius:{{ block.settings.corner_radius }}px}.ai-timeline__inner-{{ ai_gen_id }}{max-width:820px;margin:0 auto}.ai-timeline__heading-{{ ai_gen_id }}{margin:0 0 36px;color:{{ block.settings.heading_color }};text-align:{{ block.settings.alignment }};font-size:{{ block.settings.heading_size }}px}.ai-timeline__items-{{ ai_gen_id }}{position:relative;display:grid}.ai-timeline__items-{{ ai_gen_id }}:before{content:'';position:absolute;top:10px;bottom:10px;left:15px;width:2px;background:{{ block.settings.track_color }}}.ai-timeline__progress-{{ ai_gen_id }}{position:absolute;top:10px;left:15px;width:2px;height:0;background:{{ block.settings.accent_color }};transition:height .18s ease;z-index:1}.ai-timeline__item-{{ ai_gen_id }}{position:relative;display:grid;grid-template-columns:32px minmax(0,1fr);gap:22px;min-height:150px;padding-bottom:34px}.ai-timeline__marker-{{ ai_gen_id }}{position:relative;z-index:2;width:32px;height:32px;display:flex;align-items:center;justify-content:center;border:2px solid {{ block.settings.track_color }};border-radius:50%;background:{{ block.settings.background_color }};color:{{ block.settings.muted_color }};font-size:12px;font-weight:700}.ai-timeline__item-{{ ai_gen_id }}.is-active .ai-timeline__marker-{{ ai_gen_id }}{border-color:{{ block.settings.accent_color }};background:{{ block.settings.accent_color }};color:{{ block.settings.accent_text_color }}}.ai-timeline__content-{{ ai_gen_id }}{opacity:.48;transition:opacity .18s ease,transform .18s ease}.ai-timeline__item-{{ ai_gen_id }}.is-active .ai-timeline__content-{{ ai_gen_id }}{opacity:1;transform:translateX(4px)}.ai-timeline__date-{{ ai_gen_id }}{margin:0 0 7px;color:{{ block.settings.accent_color }};font-size:13px;font-weight:700;text-transform:uppercase}.ai-timeline__title-{{ ai_gen_id }}{margin:0 0 8px;color:{{ block.settings.heading_color }};font-size:{{ block.settings.item_title_size }}px}.ai-timeline__description-{{ ai_gen_id }}{margin:0;color:{{ block.settings.text_color }};font-size:{{ block.settings.body_size }}px;line-height:1.6}@media(max-width:749px){.ai-timeline-{{ ai_gen_id }}{width:100%;padding:32px 20px}.ai-timeline__item-{{ ai_gen_id }}{grid-template-columns:28px minmax(0,1fr);gap:16px;min-height:140px}.ai-timeline__items-{{ ai_gen_id }}:before,.ai-timeline__progress-{{ ai_gen_id }}{left:13px}.ai-timeline__marker-{{ ai_gen_id }}{width:28px;height:28px}}{% endstyle %}
<scroll-timeline-{{ ai_gen_id }} class="ai-timeline-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-timeline__inner-{{ ai_gen_id }}">{% if block.settings.heading != blank %}<h2 class="ai-timeline__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>{% endif %}<div class="ai-timeline__items-{{ ai_gen_id }}"><div class="ai-timeline__progress-{{ ai_gen_id }}"></div>{% for i in (1..6) %}{% assign date_key = 'item_' | append: i | append: '_date' %}{% assign title_key = 'item_' | append: i | append: '_title' %}{% assign description_key = 'item_' | append: i | append: '_description' %}{% assign item_date = block.settings[date_key] %}{% assign item_title = block.settings[title_key] %}{% assign item_description = block.settings[description_key] %}{% if item_title != blank or item_description != blank %}<article class="ai-timeline__item-{{ ai_gen_id }}" data-timeline-item><div class="ai-timeline__marker-{{ ai_gen_id }}">{{ i }}</div><div class="ai-timeline__content-{{ ai_gen_id }}">{% if item_date != blank %}<p class="ai-timeline__date-{{ ai_gen_id }}">{{ item_date | escape }}</p>{% endif %}{% if item_title != blank %}<h3 class="ai-timeline__title-{{ ai_gen_id }}">{{ item_title | escape }}</h3>{% endif %}{% if item_description != blank %}<p class="ai-timeline__description-{{ ai_gen_id }}">{{ item_description | escape | newline_to_br }}</p>{% endif %}</div></article>{% endif %}{% endfor %}</div></div></scroll-timeline-{{ ai_gen_id }}>
<script>(function(){class ScrollTimeline{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.items=[...this.querySelectorAll('[data-timeline-item]')];this.progress=this.querySelector('.ai-timeline__progress-{{ ai_gen_id }}');this.observer=new IntersectionObserver((e)=>{e.forEach(x=>{if(x.isIntersecting)x.target.classList.add('is-active')});this.update()},{threshold:.45,rootMargin:'-10% 0px -35% 0px'});this.items.forEach(x=>this.observer.observe(x));this.update();this.handleScroll=()=>this.update();window.addEventListener('scroll',this.handleScroll,{passive:true})}update(){if(!this.progress)return;let active=this.items.filter(x=>x.classList.contains('is-active'));if(!active.length)return;let box=this.querySelector('.ai-timeline__items-{{ ai_gen_id }}').getBoundingClientRect(),marker=active[active.length-1].querySelector('.ai-timeline__marker-{{ ai_gen_id }}').getBoundingClientRect();this.progress.style.height=Math.max(0,Math.min(box.height-10,marker.top-box.top+marker.height/2))+'px'}disconnectedCallback(){if(this.observer)this.observer.disconnect();if(this.handleScroll)window.removeEventListener('scroll',this.handleScroll)}}if(!customElements.get('scroll-timeline-{{ ai_gen_id }}'))customElements.define('scroll-timeline-{{ ai_gen_id }}',ScrollTimeline{{ ai_gen_id }})})();</script>
{% schema %}{"name":"Cronologie derulantă","settings":[{"type":"header","content":"Conținut"},{"type":"text","id":"heading","label":"Titlu","default":"Povestea noastră"},{"type":"text","id":"item_1_date","label":"Data 1","default":"Început"},{"type":"text","id":"item_1_title","label":"Titlu 1","default":"O idee prinde contur"},{"type":"textarea","id":"item_1_description","label":"Descriere 1","default":"Totul a început cu dorința de a crea produse memorabile și plăcute la atingere."},{"type":"text","id":"item_2_date","label":"Data 2","default":"Primul pas"},{"type":"text","id":"item_2_title","label":"Titlu 2","default":"Primele produse"},{"type":"textarea","id":"item_2_description","label":"Descriere 2","default":"Am ales cu atenție fiecare detaliu pentru o experiență plăcută."},{"type":"text","id":"item_3_date","label":"Data 3","default":"Astăzi"},{"type":"text","id":"item_3_title","label":"Titlu 3","default":"Creștem împreună"},{"type":"textarea","id":"item_3_description","label":"Descriere 3","default":"Descoperim constant idei noi și le transformăm în cadouri simpatice."},{"type":"text","id":"item_4_date","label":"Data 4","default":"În curând"},{"type":"text","id":"item_4_title","label":"Titlu 4","default":"Urmează lucruri frumoase"},{"type":"textarea","id":"item_4_description","label":"Descriere 4","default":"Rămâi aproape pentru următoarele colecții și surprize."},{"type":"text","id":"item_5_date","label":"Data 5","default":"Etapa următoare"},{"type":"text","id":"item_5_title","label":"Titlu 5","default":"O comunitate mai mare"},{"type":"textarea","id":"item_5_description","label":"Descriere 5","default":"Construim o comunitate care apreciază lucrurile mici și pline de personalitate."},{"type":"text","id":"item_6_date","label":"Data 6","default":"Viitor"},{"type":"text","id":"item_6_title","label":"Titlu 6","default":"Mai multe zâmbete"},{"type":"textarea","id":"item_6_description","label":"Descriere 6","default":"Misiunea noastră este să aducem mai multă bucurie în fiecare zi."},{"type":"header","content":"Aspect"},{"type":"select","id":"alignment","label":"Aliniere titlu","options":[{"value":"left","label":"Stânga"},{"value":"center","label":"Centru"}],"default":"left"},{"type":"range","id":"desktop_width_percent","label":"Lățime desktop","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"vertical_padding","label":"Spațiere verticală","min":20,"max":100,"step":5,"unit":"px","default":55},{"type":"range","id":"horizontal_padding","label":"Spațiere orizontală","min":12,"max":80,"step":4,"unit":"px","default":32},{"type":"range","id":"corner_radius","label":"Rotunjire colțuri","min":0,"max":32,"step":2,"unit":"px","default":12},{"type":"range","id":"heading_size","label":"Dimensiune titlu","min":20,"max":52,"step":2,"unit":"px","default":32},{"type":"range","id":"item_title_size","label":"Dimensiune subtitluri","min":16,"max":32,"step":2,"unit":"px","default":22},{"type":"range","id":"body_size","label":"Dimensiune text","min":13,"max":20,"step":1,"unit":"px","default":16},{"type":"color","id":"background_color","label":"Fundal","default":"#FFF8F1"},{"type":"color","id":"heading_color","label":"Titluri","default":"#252525"},{"type":"color","id":"text_color","label":"Text","default":"#454545"},{"type":"color","id":"accent_color","label":"Accent","default":"#8A4B2A"},{"type":"color","id":"accent_text_color","label":"Text accent","default":"#FFFFFF"},{"type":"color","id":"track_color","label":"Linie","default":"#D9C9BD"},{"type":"color","id":"muted_color","label":"Text secundar","default":"#665C56"}],"presets":[{"name":"Cronologie derulantă"}],"tag":null,"class":"timeline-block"}{% endschema %}